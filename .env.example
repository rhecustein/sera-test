# App
NODE_ENV=development
PORT=60010
APP_NAME=SERA Backend Test

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=sera_db
DB_USER=sera_user
DB_PASS=sera_password

# JWT
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars
JWT_EXPIRES_IN=1h

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Mail (SMTP Hostinger)
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your@domain.com
MAIL_PASS=your-smtp-password
MAIL_FROM=SERA System <your@domain.com>

# CORS
CORS_ORIGIN=http://localhost:60011

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=60
